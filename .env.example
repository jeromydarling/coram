# Local development only. Real values go in via `wrangler secret put`.
# Nothing in this file is read in production.

# Signing key for session JWTs. Generate with:
#   openssl rand -base64 48
AUTH_JWT_SECRET=

# Private inference host for Scriba (§5.10). Not used until that module lands.
INFERENCE_ENDPOINT=
INFERENCE_KEY=

# Stripe, routed through the CROS hub (§5.6).
FEDERATION_STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Fingerprint of the PGP key the warrant canary is signed with (§7).
CANARY_PUBKEY_FINGERPRINT=
